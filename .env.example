# Copy to .env for local development. Never commit .env.
# On Render, set these in the service's Environment tab instead.
# All of these are read by the server only. None are exposed to the browser.

NODE_ENV=production
# Render sets PORT itself; locally the server defaults to 8080.
# PORT=8080

# ── Google Sheets (data store) ───────────────────────────────────────────────
# The spreadsheet id from its URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# The service account's JSON key, base64-encoded on one line:
#   base64 -w0 service-account.json        (Linux)
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))   (PowerShell)
# Share the spreadsheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Local development without Sheets: set to "memory" (data is lost on restart; refused in production).
# SHEETS_BACKEND=memory

# ── Sessions ─────────────────────────────────────────────────────────────────
# 32+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# ── Accounts ─────────────────────────────────────────────────────────────────
# Only addresses on exactly this domain can have accounts or sign in (no subdomains).
# There is no sign-up: accounts come only from SUPERADMIN_EMAIL and TEAM_USERS below.
ALLOWED_EMAIL_DOMAIN=azumco.com
SUPERADMIN_EMAIL=firstname.lastname@azumco.com
# Full name. The seed data matches people by first name, so use real first names here and in TEAM_USERS.
SUPERADMIN_NAME=Firstname Lastname
# Used once, to create the super_admin on first start; must be changed at first sign-in.
# Remove it from the environment after that (the server logs a reminder while it is set).
SUPERADMIN_INITIAL_PASSWORD=
# The other team members, created with no password. The super_admin issues each a one-time password
# in Settings → Users. Roles: "admin" or "employee". Every email must be on ALLOWED_EMAIL_DOMAIN.
TEAM_USERS=[{"name":"Firstname Lastname","email":"firstname.lastname@azumco.com","role":"admin"},{"name":"Firstname Lastname","email":"another.person@azumco.com","role":"admin"},{"name":"Firstname Lastname","email":"third.person@azumco.com","role":"employee"}]

# ── Google Places (Find clients) ─────────────────────────────────────────────
# Optional: Find clients turns itself off when this is empty. Enable "Places API (New)"
# and restrict the key to that API.
GOOGLE_PLACES_API_KEY=
# Bearer token for POST /api/maintenance/run (the scheduler's assignment-expiry sweep).
# 32+ random characters. When empty, the endpoint is disabled.
CRON_TOKEN=
