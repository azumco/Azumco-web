{
  "name": "azumco-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist-server/index.js",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:live": "tsx --env-file=.env server/test/live.ts",
    "scan:secrets": "tsx --env-file-if-exists=.env server/test/scan-secrets.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "lenis": "^1.3.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
